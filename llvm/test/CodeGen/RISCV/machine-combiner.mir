    ; CHECK-NEXT: [[ADD1:%[0-9]+]]:gpr = ADD killed [[MUL]], killed [[ADD]]
    ; CHECK-NEXT: [[ADDI:%[0-9]+]]:gpr = ADDI [[ADD1]], 2

    ; CHECK-NEXT: [[ADDI:%[0-9]+]]:gpr = ADDI [[ADD]], 2
    ; CHECK-NEXT: [[DIV:%[0-9]+]]:gpr = DIV killed [[ADD]], killed [[ADDI]]
    ; CHECK-NEXT: $x10 = COPY [[DIV]]
    ; CHECK-NEXT: PseudoRET implicit $x10
